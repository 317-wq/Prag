# ============================================================
# 应用基础配置
# ============================================================
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
LOG_FILE_PATH=./data/logs/app.log

# ============================================================
# 数据库（PostgreSQL + pgvector）
# ============================================================
# 本地开发用 localhost；Docker 内用服务名 postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=raguser
POSTGRES_PASSWORD=
POSTGRES_DB=Prag

# 完整连接串，代码里显式传给 SQLAlchemy 和 LlamaIndex
DATABASE_URL=postgresql://raguser:@localhost:5432/Prag

# LlamaIndex PGVectorStore 隐式读取的变量（与上面保持一致，密钥留空）
PGHOST=localhost
PGPORT=5432
PGUSER=raguser
PGPASSWORD=
PGDATABASE=Prag

# ============================================================
# 文件上传
# ============================================================
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=20
ALLOWED_FILE_TYPES=md,pdf,doc,docx,txt

# ============================================================
# 向量模型（阿里云百炼 qwen3.7-text-embedding）
# ============================================================
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_EMBEDDING_MODEL=qwen3.7-text-embedding
QWEN_EMBEDDING_MODEL_FLASH=qwen3.7-text-embedding-flash
QWEN_EMBEDDING_DIMENSION=1024

# ============================================================
# 语言模型（OpenAI 兼容，中转站）
# ============================================================
GPT_API_KEY=
GPT_BASE_URL=https://heyroute.ai/v1
GPT_CHAT_MODEL=gpt-5.5
GPT_TEMPERATURE=0.3
GPT_MAX_TOKENS=2000
GPT_TIMEOUT_SECONDS=60

# ============================================================
# 认证
# ============================================================
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ============================================================
# 文本分块
# ============================================================
CHUNK_MAX_LENGTH=1000
CHUNK_OVERLAP=100

# ============================================================
# 检索参数
# ============================================================
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.3

# ============================================================
# 在线搜索（V2 引入）
# ============================================================
ONLINE_SEARCH_ENABLED=false
ONLINE_SEARCH_CONFIDENCE_THRESHOLD=60
TAVILY_API_KEY=
# TAVILY_BASE_URL=https://api.tavily.com